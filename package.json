{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "svg-browser",
  "version": "0.0.1",
  "title": "SVG Browser",
  "description": "Browse a folder of SVG files.",
  "icon": "icon.png",
  "author": "ViggoV",
  "license": "MIT",
  "commands": [
    {
      "name": "browseSVGs",
      "title": "Browse SVGs",
      "description": "Browse SVG files in a configured folder",
      "mode": "view"
    },
    {
      "name": "manageSVGFolders",
      "title": "Manage SVG Folders",
      "description": "Add, remove, or view configured SVG folders",
      "mode": "view"
    }
  ],
  "preferences": [],
  "dependencies": {
    "@raycast/api": "^1.77.0",
    "@raycast/utils": "^1.15.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "jest",
    "publish": "npx @raycast/api@latest publish"
  }
}
